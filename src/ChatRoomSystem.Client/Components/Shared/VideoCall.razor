@using ChatRoomSystem.Client.Services
@inject WebRTCService WebRTCService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="video-call-container @(isMinimized ? "minimized" : "")">
    @if (!isInCall)
    {
        <!-- Call Controls -->
        <div class="call-controls">
            <button class="btn btn-success" @onclick="StartCall" disabled="@isInitiating">
                <span class="@(isInitiating ? "spinner-border spinner-border-sm" : "")"></span>
                📹 Start Video Call
            </button>
        </div>
    }
    else
    {
        <!-- Active Call UI -->
        <div class="video-grid">
            <!-- Local Video -->
            <div class="video-wrapper local-video">
                <video id="local-video-@callId" autoplay muted playsinline></video>
                <div class="video-label">You @(isVideoEnabled ? "" : "(Video Off)")</div>
            </div>

            <!-- Remote Video -->
            <div class="video-wrapper remote-video">
                <video id="remote-video-@callId" autoplay playsinline></video>
                <div class="video-label">@remoteName @(isConnected ? "" : "Connecting...")</div>
            </div>
        </div>

        <!-- Call Controls Bar -->
        <div class="call-controls-bar">
            <button class="btn @(isVideoEnabled ? "btn-primary" : "btn-secondary")"
                    @onclick="ToggleVideo"
                    title="Toggle Video">
                @(isVideoEnabled ? "📹" : "📹̸") Video
            </button>

            <button class="btn @(isAudioEnabled ? "btn-primary" : "btn-secondary")"
                    @onclick="ToggleAudio"
                    title="Toggle Audio">
                @(isAudioEnabled ? "🎤" : "🎤̸") Mic
            </button>

            <button class="btn btn-info"
                    @onclick="StartScreenShare"
                    title="Share Screen"
                    disabled="@isScreenSharing">
                🖥️ Share
            </button>

            @if (isScreenSharing)
            {
                <button class="btn btn-warning" @onclick="StopScreenShare">
                    ⏹️ Stop Sharing
                </button>
            }

            <button class="btn btn-danger" @onclick="EndCall" title="End Call">
                ☎️ End
            </button>

            <button class="btn btn-secondary" @onclick="ToggleMinimize">
                @(isMinimized ? "🔼" : "🔽")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-2">@errorMessage</div>
        }
    }

    @if (hasIncomingCall && !isInCall)
    {
        <!-- Incoming Call Alert -->
        <div class="incoming-call-alert">
            <div class="alert alert-info">
                <h5>📞 Incoming Call from @incomingCallFrom</h5>
                <div class="mt-2">
                    <button class="btn btn-success me-2" @onclick="AcceptCall">Accept</button>
                    <button class="btn btn-danger" @onclick="RejectCall">Reject</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .video-call-container {
        background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
        border-radius: var(--radius-2xl);
        padding: var(--spacing-xl);
        margin: var(--spacing-lg) 0;
        box-shadow: var(--shadow-2xl);
        border: 2px solid var(--color-gray-700);
    }

    .video-call-container.minimized .video-grid {
        display: none;
    }

    .video-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-xl);
    }

    .video-wrapper {
        position: relative;
        background: #000;
        border-radius: var(--radius-xl);
        overflow: hidden;
        aspect-ratio: 16/9;
        box-shadow: var(--shadow-xl);
        transition: all var(--transition-base);
    }

    .video-wrapper:hover {
        transform: scale(1.02);
        box-shadow: 0 0 30px rgba(99, 102, 241, 0.4);
    }

    .video-wrapper video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .video-label {
        position: absolute;
        bottom: var(--spacing-md);
        left: var(--spacing-md);
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
        color: white;
        padding: var(--spacing-sm) var(--spacing-lg);
        border-radius: var(--radius-full);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        box-shadow: var(--shadow-lg);
    }

    .local-video {
        border: 3px solid var(--color-primary);
    }

    .remote-video {
        border: 3px solid var(--color-accent);
    }

    .call-controls,
    .call-controls-bar {
        display: flex;
        gap: var(--spacing-md);
        justify-content: center;
        flex-wrap: wrap;
        padding: var(--spacing-md);
        background: rgba(255, 255, 255, 0.05);
        border-radius: var(--radius-xl);
    }

    .call-controls-bar .btn {
        padding: var(--spacing-md) var(--spacing-lg);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        min-width: 100px;
        box-shadow: var(--shadow-lg);
    }

    .incoming-call-alert {
        position: fixed;
        top: var(--spacing-xl);
        right: var(--spacing-xl);
        z-index: var(--z-modal);
        box-shadow: var(--shadow-2xl);
        border-radius: var(--radius-2xl);
        overflow: hidden;
        animation: slideDown 0.4s ease-out;
        max-width: 400px;
    }

    .incoming-call-alert .alert {
        margin: 0;
        padding: var(--spacing-xl);
        border: 2px solid var(--color-info);
    }

    .incoming-call-alert h5 {
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--spacing-md);
    }

    @@media (max-width: 768px) {
        .video-grid {
            grid-template-columns: 1fr;
        }

        .call-controls-bar {
            gap: var(--spacing-sm);
        }

        .call-controls-bar .btn {
            padding: var(--spacing-sm) var(--spacing-md);
            font-size: var(--font-size-sm);
            min-width: auto;
        }

        .incoming-call-alert {
            top: var(--spacing-md);
            right: var(--spacing-md);
            left: var(--spacing-md);
            max-width: none;
        }
    }
</style>

@code {
    [Parameter]
    public string RoomId { get; set; } = "";

    [Parameter]
    public string? RemoteUserId { get; set; }

    [Parameter]
    public string RemoteName { get; set; } = "Remote User";

    private string? callId;
    private bool isInCall = false;
    private bool isInitiating = false;
    private bool isConnected = false;
    private bool isVideoEnabled = true;
    private bool isAudioEnabled = true;
    private bool isScreenSharing = false;
    private bool isMinimized = false;
    private string? errorMessage;
    private string remoteName = "";

    // Incoming call
    private bool hasIncomingCall = false;
    private string? incomingCallId;
    private string? incomingCallFrom;

    protected override async Task OnInitializedAsync()
    {
        // Initialize WebRTC
        await WebRTCService.InitializeAsync();

        // Subscribe to events
        WebRTCService.OnIncomingCall += HandleIncomingCall;
        WebRTCService.OnCallAccepted += HandleCallAccepted;
        WebRTCService.OnCallRejected += HandleCallRejected;
        WebRTCService.OnCallEnded += HandleCallEnded;
        WebRTCService.OnRemoteStreamAvailable += HandleRemoteStream;

        remoteName = RemoteName;
    }

    private async Task StartCall()
    {
        if (string.IsNullOrEmpty(RemoteUserId))
        {
            errorMessage = "Remote user ID required";
            return;
        }

        isInitiating = true;
        errorMessage = null;

        try
        {
            callId = await WebRTCService.InitiateCallAsync(RemoteUserId, RoomId, includeVideo: true, includeAudio: true);
            isInCall = true;

            // Wait for JS to initialize video elements
            await Task.Delay(100);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to start call: {ex.Message}";
        }
        finally
        {
            isInitiating = false;
            StateHasChanged();
        }
    }

    private void HandleIncomingCall(string newCallId, string fromUserId)
    {
        InvokeAsync(() =>
        {
            incomingCallId = newCallId;
            incomingCallFrom = fromUserId;
            hasIncomingCall = true;
            StateHasChanged();
        });
    }

    private async Task AcceptCall()
    {
        if (string.IsNullOrEmpty(incomingCallId) || string.IsNullOrEmpty(incomingCallFrom))
        {
            return;
        }

        hasIncomingCall = false;
        callId = incomingCallId;
        isInCall = true;

        await WebRTCService.AcceptCallAsync(callId, incomingCallFrom);

        // Wait for JS to initialize
        await Task.Delay(100);
        StateHasChanged();
    }

    private async Task RejectCall()
    {
        if (!string.IsNullOrEmpty(incomingCallId) && !string.IsNullOrEmpty(incomingCallFrom))
        {
            await WebRTCService.RejectCallAsync(incomingCallId, incomingCallFrom);
        }

        hasIncomingCall = false;
        incomingCallId = null;
        incomingCallFrom = null;
        StateHasChanged();
    }

    private void HandleCallAccepted(string acceptedCallId)
    {
        if (acceptedCallId == callId)
        {
            InvokeAsync(() =>
            {
                isConnected = true;
                StateHasChanged();
            });
        }
    }

    private void HandleCallRejected(string rejectedCallId)
    {
        if (rejectedCallId == callId)
        {
            InvokeAsync(() =>
            {
                errorMessage = "Call rejected by remote user";
                isInCall = false;
                StateHasChanged();
            });
        }
    }

    private void HandleCallEnded(string endedCallId)
    {
        if (endedCallId == callId)
        {
            InvokeAsync(() =>
            {
                isInCall = false;
                isConnected = false;
                callId = null;
                StateHasChanged();
            });
        }
    }

    private void HandleRemoteStream(string streamCallId, string streamId)
    {
        if (streamCallId == callId)
        {
            InvokeAsync(() =>
            {
                isConnected = true;
                StateHasChanged();
            });
        }
    }

    private async Task ToggleVideo()
    {
        if (!string.IsNullOrEmpty(callId))
        {
            await WebRTCService.ToggleVideoAsync(callId);
            isVideoEnabled = !isVideoEnabled;
        }
    }

    private async Task ToggleAudio()
    {
        if (!string.IsNullOrEmpty(callId))
        {
            await WebRTCService.ToggleAudioAsync(callId);
            isAudioEnabled = !isAudioEnabled;
        }
    }

    private async Task StartScreenShare()
    {
        if (string.IsNullOrEmpty(callId))
        {
            return;
        }

        try
        {
            await WebRTCService.StartScreenShareAsync(callId);
            isScreenSharing = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Screen share failed: {ex.Message}";
        }
    }

    private async Task StopScreenShare()
    {
        if (!string.IsNullOrEmpty(callId))
        {
            await WebRTCService.StopScreenShareAsync(callId);
            isScreenSharing = false;
        }
    }

    private async Task EndCall()
    {
        if (!string.IsNullOrEmpty(callId))
        {
            await WebRTCService.EndCallAsync(callId);
            isInCall = false;
            isConnected = false;
            isScreenSharing = false;
            callId = null;
        }
    }

    private void ToggleMinimize()
    {
        isMinimized = !isMinimized;
    }

    public async ValueTask DisposeAsync()
    {
        // Unsubscribe events
        WebRTCService.OnIncomingCall -= HandleIncomingCall;
        WebRTCService.OnCallAccepted -= HandleCallAccepted;
        WebRTCService.OnCallRejected -= HandleCallRejected;
        WebRTCService.OnCallEnded -= HandleCallEnded;
        WebRTCService.OnRemoteStreamAvailable -= HandleRemoteStream;

        // End call if active
        if (!string.IsNullOrEmpty(callId))
        {
            await WebRTCService.EndCallAsync(callId);
        }
    }
}
