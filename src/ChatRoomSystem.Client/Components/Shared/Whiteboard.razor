@using ChatRoomSystem.Client.Services
@using ChatRoomSystem.Shared.Models
@inject WebSocketService WebSocketService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="whiteboard-container">
    <!-- Toolbar -->
    <div class="whiteboard-toolbar">
        <div class="tool-group">
            <button class="tool-btn @(currentTool == "pen" ? "active" : "")"
                    @onclick='() => SelectTool("pen")'
                    title="Pen">
                ✏️ Pen
            </button>

            <button class="tool-btn @(currentTool == "eraser" ? "active" : "")"
                    @onclick='() => SelectTool("eraser")'
                    title="Eraser">
                🧹 Eraser
            </button>

            <button class="tool-btn @(currentTool == "line" ? "active" : "")"
                    @onclick='() => SelectTool("line")'
                    title="Line">
                📏 Line
            </button>

            <button class="tool-btn @(currentTool == "rect" ? "active" : "")"
                    @onclick='() => SelectTool("rect")'
                    title="Rectangle">
                ▭ Rect
            </button>

            <button class="tool-btn @(currentTool == "circle" ? "active" : "")"
                    @onclick='() => SelectTool("circle")'
                    title="Circle">
                ⭕ Circle
            </button>
        </div>

        <div class="tool-group">
            <label>Color:</label>
            <input type="color" @bind="currentColor" @bind:event="oninput" class="color-picker" />
        </div>

        <div class="tool-group">
            <label>Width:</label>
            <input type="range" min="1" max="20" @bind="strokeWidth" @bind:event="oninput" class="width-slider" />
            <span>@strokeWidth px</span>
        </div>

        <div class="tool-group">
            <button class="btn btn-warning btn-sm" @onclick="ClearCanvas">
                🗑️ Clear
            </button>

            <button class="btn btn-primary btn-sm" @onclick="SaveCanvas">
                💾 Save
            </button>
        </div>
    </div>

    <!-- Canvas -->
    <div class="canvas-wrapper">
        <canvas id="whiteboard-canvas-@RoomId"
                width="800"
                height="600"
                @ref="canvasElement">
        </canvas>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info mt-2">@statusMessage</div>
    }
</div>

<style>
    .whiteboard-container {
        background: white;
        border-radius: var(--radius-2xl);
        padding: var(--spacing-xl);
        box-shadow: var(--shadow-xl);
        border: 2px solid var(--color-gray-100);
    }

    .whiteboard-toolbar {
        display: flex;
        gap: var(--spacing-lg);
        flex-wrap: wrap;
        align-items: center;
        padding: var(--spacing-lg);
        background: linear-gradient(135deg, var(--color-gray-50) 0%, var(--color-gray-100) 100%);
        border-radius: var(--radius-xl);
        margin-bottom: var(--spacing-xl);
        box-shadow: var(--shadow-sm);
    }

    .tool-group {
        display: flex;
        gap: var(--spacing-sm);
        align-items: center;
        padding: var(--spacing-xs);
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
    }

    .tool-group label {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        color: var(--color-gray-700);
        margin-right: var(--spacing-xs);
    }

    .tool-btn {
        padding: var(--spacing-sm) var(--spacing-lg);
        border: 2px solid var(--color-gray-300);
        background: white;
        border-radius: var(--radius-lg);
        cursor: pointer;
        transition: all var(--transition-base);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-medium);
        color: var(--color-gray-700);
    }

    .tool-btn:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        color: var(--color-primary);
    }

    .tool-btn.active {
        background: var(--color-primary);
        color: white;
        border-color: var(--color-primary);
        box-shadow: var(--shadow-md);
    }

    .color-picker {
        width: 60px;
        height: 45px;
        border: 3px solid var(--color-gray-300);
        border-radius: var(--radius-lg);
        cursor: pointer;
        transition: all var(--transition-base);
    }

    .color-picker:hover {
        border-color: var(--color-primary);
        transform: scale(1.05);
    }

    .width-slider {
        width: 120px;
        height: 8px;
        border-radius: var(--radius-full);
        background: var(--color-gray-200);
        outline: none;
        -webkit-appearance: none;
    }

    .width-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--color-primary);
        cursor: pointer;
        box-shadow: var(--shadow-md);
        transition: all var(--transition-base);
    }

    .width-slider::-webkit-slider-thumb:hover {
        transform: scale(1.2);
        box-shadow: var(--shadow-lg);
    }

    .canvas-wrapper {
        border: 3px solid var(--color-gray-300);
        border-radius: var(--radius-xl);
        overflow: hidden;
        background: white;
        box-shadow: var(--shadow-inner);
        transition: border-color var(--transition-base);
    }

    .canvas-wrapper:hover {
        border-color: var(--color-primary-light);
    }

    #whiteboard-canvas-@RoomId {
        display: block;
        cursor: crosshair;
        width: 100%;
        height: auto;
    }

    .alert {
        margin-top: var(--spacing-md);
        animation: slideDown 0.3s ease-out;
    }

    @media (max-width: 768px) {
        .whiteboard-toolbar {
            gap: var(--spacing-md);
            padding: var(--spacing-md);
        }

        .tool-group {
            width: 100%;
            justify-content: space-between;
        }

        .tool-btn {
            flex: 1;
            padding: var(--spacing-sm);
            font-size: var(--font-size-sm);
        }

        .width-slider {
            width: 80px;
        }
    }
</style>

@code {
    [Parameter]
    public string RoomId { get; set; } = "";

    private ElementReference canvasElement;
    private string currentTool = "pen";
    private string currentColor = "#000000";
    private int strokeWidth = 2;
    private string? statusMessage;

    // Drawing state
    private bool isDrawing = false;
    private double startX = 0;
    private double startY = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize canvas
            await JSRuntime.InvokeVoidAsync("whiteboard.initialize", RoomId, DotNetObjectReference.Create(this));

            // Subscribe to WebSocket events
            WebSocketService.OnMessageReceived += HandleIncomingDraw;
        }
    }

    private void SelectTool(string tool)
    {
        currentTool = tool;
        _ = JSRuntime.InvokeVoidAsync("whiteboard.setTool", RoomId, tool);
    }

    private async Task ClearCanvas()
    {
        await JSRuntime.InvokeVoidAsync("whiteboard.clear", RoomId);

        // Broadcast clear to room
        await WebSocketService.SendAsync(new WebSocketMessage
        {
            Type = WebSocketMessageType.WhiteboardClear,
            Data = System.Text.Json.JsonSerializer.Serialize(new WhiteboardPayload
            {
                RoomId = RoomId,
                Action = "clear"
            })
        });

        statusMessage = "Whiteboard cleared";
        await Task.Delay(2000);
        statusMessage = null;
        StateHasChanged();
    }

    private async Task SaveCanvas()
    {
        var dataUrl = await JSRuntime.InvokeAsync<string>("whiteboard.export", RoomId);

        // Download image
        await JSRuntime.InvokeVoidAsync("whiteboard.download", dataUrl, $"whiteboard-{DateTime.Now:yyyyMMdd-HHmmss}.png");

        statusMessage = "Whiteboard saved!";
        await Task.Delay(2000);
        statusMessage = null;
        StateHasChanged();
    }

    /// <summary>
    /// Callback từ JS khi user vẽ
    /// </summary>
    [JSInvokable]
    public async Task OnDraw(string action, double x1, double y1, double x2, double y2)
    {
        // Broadcast stroke to room
        var stroke = new WhiteboardStroke
        {
            Points = new List<WhiteboardPoint>
            {
                new WhiteboardPoint { X = x1, Y = y1 },
                new WhiteboardPoint { X = x2, Y = y2 }
            },
            Color = currentColor,
            Width = strokeWidth,
            Tool = currentTool
        };

        await WebSocketService.SendAsync(new WebSocketMessage
        {
            Type = WebSocketMessageType.WhiteboardDraw,
            Data = System.Text.Json.JsonSerializer.Serialize(new WhiteboardPayload
            {
                RoomId = RoomId,
                Action = action,
                Stroke = stroke
            })
        });
    }

    /// <summary>
    /// Handle incoming draw from WebSocket
    /// </summary>
    private void HandleIncomingDraw(MessageDto message)
    {
        // This would be handled by whiteboard-specific WebSocket messages
        // For now, we handle via OnWhiteboardData callback
    }

    public async ValueTask DisposeAsync()
    {
        WebSocketService.OnMessageReceived -= HandleIncomingDraw;
        await JSRuntime.InvokeVoidAsync("whiteboard.dispose", RoomId);
    }
}
