@inherits LayoutComponentBase
@using ChatRoomSystem.Client.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation

<WebSocketInitializer />

<!-- Import Font -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="app-layout">
    @if (isInitialized && AuthService.IsAuthenticated)
    {
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <!-- Brand / Logo -->
            <div class="sidebar-header">
                <div class="brand-logo">
                    <i class="fa-solid fa-comments"></i>
                </div>
                <span class="brand-text">ChatRoom</span>
            </div>

            <!-- Navigation Links -->
            <nav class="sidebar-menu">
                <NavLink class="menu-item" href="/rooms" Match="NavLinkMatch.All">
                    <div class="icon-box"><i class="fa-solid fa-house"></i></div>
                    <span class="label">Rooms</span>
                </NavLink>

                <NavLink class="menu-item" href="/messages">
                    <div class="icon-box relative">
                        <i class="fa-solid fa-message"></i>
                        @if (unreadMessagesCount > 0)
                        {
                            <span class="notification-dot"></span>
                        }
                    </div>
                    <span class="label">Messages</span>
                    @if (unreadMessagesCount > 0)
                    {
                        <span class="badge">@unreadMessagesCount</span>
                    }
                </NavLink>

                <NavLink class="menu-item" href="/friends">
                    <div class="icon-box relative">
                        <i class="fa-solid fa-user-group"></i>
                        @if (friendRequestsCount > 0)
                        {
                            <span class="notification-dot warning"></span>
                        }
                    </div>
                    <span class="label">Friends</span>
                    @if (friendRequestsCount > 0)
                    {
                        <span class="badge warning">@friendRequestsCount</span>
                    }
                </NavLink>

                <NavLink class="menu-item" href="/notifications">
                    <div class="icon-box relative">
                        <i class="fa-solid fa-bell"></i>
                        @if (notificationsCount > 0)
                        {
                            <span class="notification-dot danger"></span>
                        }
                    </div>
                    <span class="label">Notifications</span>
                    @if (notificationsCount > 0)
                    {
                        <span class="badge danger">@notificationsCount</span>
                    }
                </NavLink>
            </nav>

            <!-- User Profile & Logout (Bottom) -->
            <div class="sidebar-footer">
                <div class="user-card">
                    <div class="user-avatar">
                        @GetInitials(AuthService.CurrentUser?.Username)
                        <span class="status-indicator online"></span>
                    </div>
                    <div class="user-info">
                        <div class="username">@AuthService.CurrentUser?.Username</div>
                        <div class="user-status">Online</div>
                    </div>
                </div>
                <button class="btn-logout" @onclick="HandleLogout" title="Đăng xuất">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Top Header (Mobile only or for Breadcrumbs later) -->
            <div class="content-wrapper">
                @Body
            </div>
        </main>
    }
    else
    {
        <!-- Full Screen Content (Login/Register) -->
        <main class="main-content-full">
            @Body
        </main>
    }
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    :root {
        --sidebar-bg: #1e1e2d;
        --sidebar-hover: #2b2b40;
        --sidebar-active: #3699ff; /* Blue accent */
        --sidebar-text: #a2a3b7;
        --sidebar-text-active: #ffffff;
        --bg-body: #f3f6f9;
        --bg-content: #ffffff;
        --color-primary: #3699ff;
        --color-danger: #f64e60;
        --color-warning: #ffa800;
        --color-success: #1bc5bd;
        --font-family: 'Inter', sans-serif;
        --sidebar-width: 260px;
        --sidebar-width-collapsed: 80px;
        --transition: all 0.3s ease;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: var(--font-family);
        background-color: var(--bg-body);
        color: #3f4254;
    }

    .app-layout {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
        width: var(--sidebar-width);
        background-color: var(--sidebar-bg);
        display: flex;
        flex-direction: column;
        transition: var(--transition);
        z-index: 100;
        box-shadow: 4px 0 10px rgba(0,0,0,0.05);
    }

    /* Header / Logo */
    .sidebar-header {
        height: 80px;
        display: flex;
        align-items: center;
        padding: 0 25px;
        gap: 12px;
    }

    .brand-logo {
        font-size: 28px;
        color: var(--color-primary);
    }

    .brand-text {
        font-size: 20px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.5px;
    }

    /* Menu */
    .sidebar-menu {
        flex: 1;
        padding: 20px 15px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        overflow-y: auto;
    }

    .menu-item {
        display: flex;
        align-items: center;
        padding: 12px 15px;
        border-radius: 8px;
        color: var(--sidebar-text);
        text-decoration: none;
        font-weight: 500;
        font-size: 15px;
        transition: var(--transition);
        position: relative;
    }

        .menu-item:hover {
            background-color: var(--sidebar-hover);
            color: var(--sidebar-text-active);
        }

        .menu-item.active {
            background-color: var(--sidebar-active);
            color: #fff;
            box-shadow: 0 4px 12px rgba(54, 153, 255, 0.3);
        }

    .icon-box {
        width: 24px;
        font-size: 18px;
        display: flex;
        justify-content: center;
        margin-right: 12px;
    }

    .menu-item.active .icon-box {
        color: #fff;
    }

    .relative {
        position: relative;
    }

    /* Badges & Dots */
    .badge {
        margin-left: auto;
        background: var(--color-primary);
        color: white;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 700;
    }

        .badge.danger {
            background: var(--color-danger);
        }

        .badge.warning {
            background: var(--color-warning);
            color: #fff;
        }

    .notification-dot {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 8px;
        height: 8px;
        background: var(--color-primary);
        border: 2px solid var(--sidebar-bg);
        border-radius: 50%;
    }

    .menu-item:hover .notification-dot {
        border-color: var(--sidebar-hover);
    }

    .menu-item.active .notification-dot {
        border-color: var(--sidebar-active);
        background: #fff;
    }

    .notification-dot.danger {
        background: var(--color-danger);
    }

    .notification-dot.warning {
        background: var(--color-warning);
    }


    /* Footer / User Profile */
    .sidebar-footer {
        background: rgba(0,0,0,0.1);
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .user-card {
        display: flex;
        align-items: center;
        gap: 12px;
        overflow: hidden;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #895df5, #6a45c7);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        position: relative;
        flex-shrink: 0;
    }

    .status-indicator {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 12px;
        height: 12px;
        background: var(--color-success);
        border: 2px solid var(--sidebar-bg);
        border-radius: 50%;
    }

    .user-info {
        display: flex;
        flex-direction: column;
    }

    .username {
        color: #fff;
        font-weight: 600;
        font-size: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100px;
    }

    .user-status {
        color: var(--sidebar-text);
        font-size: 12px;
    }

    .btn-logout {
        background: transparent;
        border: none;
        color: var(--sidebar-text);
        font-size: 18px;
        cursor: pointer;
        padding: 8px;
        border-radius: 6px;
        transition: var(--transition);
    }

        .btn-logout:hover {
            background: rgba(255,255,255,0.1);
            color: var(--color-danger);
        }

    /* ===== MAIN CONTENT ===== */
    .main-content {
        flex: 1;
        background-color: var(--bg-body);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .content-wrapper {
        padding: 30px;
        flex: 1;
        max-width: 1600px;
        margin: 0 auto;
        width: 100%;
    }

    .main-content-full {
        width: 100%;
        height: 100vh;
        overflow-y: auto;
        background: var(--bg-body);
    }

    /* ===== ERROR UI ===== */
    #blazor-error-ui {
        background: #fff;
        box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
        color: var(--color-danger);
        padding: 1rem;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        display: none;
        text-align: center;
    }

    /* ===== SCROLLBAR ===== */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

    .sidebar-menu::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.1);
    }

        .sidebar-menu::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.2);
        }


    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        :root {
            --sidebar-width: 70px; /* Collapsed width */
        }

        .brand-text,
        .label,
        .user-info,
        .badge {
            display: none;
        }

        .sidebar-header {
            justify-content: center;
            padding: 0;
        }

        .menu-item {
            justify-content: center;
            padding: 15px 0;
        }

        .icon-box {
            margin-right: 0;
            font-size: 20px;
        }

        .sidebar-footer {
            flex-direction: column;
            gap: 15px;
            padding: 15px 0;
        }

        .user-card {
            justify-content: center;
        }

        .notification-dot {
            width: 10px;
            height: 10px;
            top: 0;
            right: 0;
            border-color: var(--sidebar-bg);
        }

        .content-wrapper {
            padding: 15px;
        }
    }
</style>

@code {
    private int unreadMessagesCount = 0;
    private int friendRequestsCount = 0;
    private int notificationsCount = 0;
    private bool isInitialized = false;

    protected override void OnInitialized()
    {
        Console.WriteLine("🔵 [MainLayout] OnInitialized START");
        AuthService.OnAuthStateChanged += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();
            if (AuthService.IsAuthenticated)
            {
                await LoadCounts();
            }
            isInitialized = true;
            StateHasChanged();
        }
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(async () =>
        {
            if (AuthService.IsAuthenticated)
            {
                await LoadCounts();
            }
            StateHasChanged();
        });
    }

    private async Task LoadCounts()
    {
        try
        {
            friendRequestsCount = (await ApiService.GetFriendRequestsAsync()).Count;
            unreadMessagesCount = await ApiService.GetUnreadMessagesCountAsync();
            notificationsCount = await ApiService.GetUnreadNotificationCountAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private string GetInitials(string? username)
    {
        if (string.IsNullOrEmpty(username)) return "?";
        var parts = username.Split(' ');
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return username.Length >= 2 ? username.Substring(0, 2).ToUpper() : username[0].ToString().ToUpper();
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }
}