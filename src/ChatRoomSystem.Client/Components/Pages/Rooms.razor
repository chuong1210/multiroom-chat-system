@page "/rooms"
@using ChatRoomSystem.Shared.Models
@using ChatRoomSystem.Client.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Rooms - Chat Room System</PageTitle>

@if (AuthService.CurrentUser == null)
{
    <p>Loading...</p>
    return;
}

<div class="rooms-container">
    <div class="rooms-header">
        <h2>Chat Rooms</h2>
        <div class="header-actions">
            <span class="user-info">👋 @AuthService.CurrentUser.Username</span>
            <button class="btn btn-primary" @onclick="ShowCreateRoomModal">+ Tạo Room</button>
            <button class="btn btn-secondary" @onclick="LogoutAsync">Đăng xuất</button>
        </div>
    </div>

    <div class="rooms-tabs">
        <button class="tab-btn @(activeTab == "my" ? "active" : "")" @onclick='() => SwitchTab("my")'>
            My Rooms
        </button>
        <button class="tab-btn @(activeTab == "public" ? "active" : "")" @onclick='() => SwitchTab("public")'>
            Public Rooms
        </button>
    </div>

    <div class="search-box">
        <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="🔍 Tìm kiếm rooms..." class="form-control" />
    </div>

    <div class="rooms-list">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border"></div>
            </div>
        }
        else if (filteredRooms.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <p>Không có room nào</p>
            </div>
        }
        else
        {
            @foreach (var room in filteredRooms)
            {
                <div class="room-card" @onclick="() => JoinRoom(room.Id)">
                    <div class="room-header">
                        <h5>@room.Name</h5>
                        @if (room.IsPrivate)
                        {
                            <span class="badge bg-warning">🔒 Private</span>
                        }
                    </div>
                    <p class="room-description">@room.Description</p>
                    <div class="room-footer">
                        <span class="badge bg-info">📁 @room.Topic</span>
                        <span class="text-muted">👥 @room.MemberIds.Count members (@room.ActiveMembersCount online)</span>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (showCreateModal)
{
    <div class="modal-overlay" @onclick="HideCreateRoomModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h4>Tạo Room Mới</h4>
            <EditForm Model="@createRoomModel" OnValidSubmit="@CreateRoomAsync">
                <div class="mb-3">
                    <label class="form-label">Tên Room</label>
                    <InputText @bind-Value="createRoomModel.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <InputTextArea @bind-Value="createRoomModel.Description" class="form-control" rows="3" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Chủ đề</label>
                    <InputText @bind-Value="createRoomModel.Topic" class="form-control" />
                </div>
                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="createRoomModel.IsPrivate" class="form-check-input" id="isPrivate" />
                    <label class="form-check-label" for="isPrivate">Private Room</label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateRoomModal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Tạo Room</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .rooms-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: var(--spacing-xl);
        min-height: 100vh;
        animation: fadeIn 0.4s ease-out;
    }

    .rooms-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-2xl);
        padding: var(--spacing-xl);
        background: white;
        border-radius: var(--radius-2xl);
        box-shadow: var(--shadow-lg);
    }

    .rooms-header h2 {
        margin: 0;
        font-size: var(--font-size-3xl);
        background: var(--bg-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .header-actions {
        display: flex;
        gap: var(--spacing-md);
        align-items: center;
        flex-wrap: wrap;
    }

    .user-info {
        font-weight: var(--font-weight-semibold);
        color: var(--color-gray-700);
        padding: var(--spacing-sm) var(--spacing-lg);
        background: var(--color-gray-100);
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .rooms-tabs {
        display: flex;
        gap: var(--spacing-sm);
        margin-bottom: var(--spacing-xl);
        background: white;
        padding: var(--spacing-sm);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-md);
    }

    .tab-btn {
        flex: 1;
        padding: var(--spacing-md) var(--spacing-xl);
        border: none;
        background: transparent;
        cursor: pointer;
        border-radius: var(--radius-lg);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-medium);
        color: var(--color-gray-600);
        transition: all var(--transition-base);
        position: relative;
    }

    .tab-btn:hover {
        background: var(--color-gray-100);
        color: var(--color-gray-900);
    }

    .tab-btn.active {
        background: var(--color-primary);
        color: white;
        box-shadow: var(--shadow-md);
    }

    .search-box {
        margin-bottom: var(--spacing-xl);
    }

    .search-box input {
        font-size: var(--font-size-lg);
        padding: var(--spacing-md) var(--spacing-lg);
        box-shadow: var(--shadow-md);
    }

    .rooms-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: var(--spacing-xl);
    }

    .room-card {
        background: white;
        padding: var(--spacing-xl);
        border-radius: var(--radius-2xl);
        box-shadow: var(--shadow-md);
        cursor: pointer;
        transition: all var(--transition-base);
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }

    .room-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--bg-gradient);
        opacity: 0;
        transition: opacity var(--transition-base);
    }

    .room-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-xl);
        border-color: var(--color-primary-light);
    }

    .room-card:hover::before {
        opacity: 1;
    }

    .room-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--spacing-md);
        gap: var(--spacing-sm);
    }

    .room-header h5 {
        margin: 0;
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        color: var(--color-gray-900);
        flex: 1;
    }

    .room-description {
        color: var(--color-gray-600);
        margin-bottom: var(--spacing-lg);
        min-height: 3rem;
        line-height: var(--line-height-relaxed);
    }

    .room-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--spacing-md);
        font-size: var(--font-size-sm);
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--color-gray-200);
    }

    .room-footer .badge {
        font-size: var(--font-size-xs);
        padding: 0.375rem 0.75rem;
    }

    @@media (max-width: 768px) {
        .rooms-container {
            padding: var(--spacing-md);
        }

        .rooms-header {
            flex-direction: column;
            gap: var(--spacing-md);
            align-items: flex-start;
        }

        .header-actions {
            width: 100%;
            justify-content: space-between;
        }

        .rooms-list {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<RoomDto> rooms = new();
    private List<RoomDto> filteredRooms = new();
    private string activeTab = "my";
    private string searchQuery = "";
    private bool isLoading = false;
    private bool showCreateModal = false;
    private CreateRoomDto createRoomModel = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadRooms();
    }

    protected override async Task OnParametersSetAsync()
    {
        FilterRooms();
    }

    private async Task LoadRooms()
    {
        isLoading = true;
        try
        {
            if (activeTab == "my")
            {
                rooms = await ApiService.GetMyRoomsAsync();
            }
            else
            {
                rooms = await ApiService.GetPublicRoomsAsync();
            }
            FilterRooms();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterRooms()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredRooms = rooms;
        }
        else
        {
            var query = searchQuery.ToLower();
            filteredRooms = rooms.Where(r =>
                r.Name.ToLower().Contains(query) ||
                r.Description.ToLower().Contains(query) ||
                r.Topic.ToLower().Contains(query)
            ).ToList();
        }
        StateHasChanged();
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        searchQuery = "";
        await LoadRooms();
    }

    private void ShowCreateRoomModal()
    {
        createRoomModel = new CreateRoomDto();
        showCreateModal = true;
    }

    private void HideCreateRoomModal()
    {
        showCreateModal = false;
    }

    private async Task CreateRoomAsync()
    {
        var room = await ApiService.CreateRoomAsync(createRoomModel);
        if (room != null)
        {
            showCreateModal = false;
            await LoadRooms();
            Navigation.NavigateTo($"/room/{room.Id}");
        }
    }

    private void JoinRoom(string roomId)
    {
        Navigation.NavigateTo($"/room/{roomId}");
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
