@page "/room/{RoomId}"
@using ChatRoomSystem.Shared.Models
@using ChatRoomSystem.Client.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject WebSocketService WebSocketService
@inject NavigationManager Navigation
@implements IAsyncDisposable
@* @rendermode InteractiveServer *@
@* @rendermode @(new InteractiveServerRenderMode(prerender: false)) *@

<PageTitle>@roomName - Chat Room</PageTitle>

@if (isInitializing)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Đang khởi tạo...</span>
        </div>
    </div>
    return;
}

@if (AuthService.CurrentUser == null)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <p>Đang chuyển hướng đến trang đăng nhập...</p>
    </div>
    return;
}

@if (room == null)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Đang tải phòng chat...</span>
        </div>
    </div>
    return;
}

<div class="chat-room-container">
    <!-- Header -->
    <div class="room-header">
        <button class="btn btn-link" @onclick="BackToRooms">← Back</button>
        <div class="room-info">
            <h4>@room.Name</h4>
            <small class="text-muted">@room.Topic | @room.MemberIds.Count members</small>
        </div>
        <div class="connection-status">
            @if (isConnected)
            {
                <span class="badge bg-success">● Connected</span>
            }
            else
            {
                <span class="badge bg-danger">○ Disconnected</span>
            }
        </div>
    </div>

    <!-- Main Content -->
    <div class="room-content">
        <!-- Messages Area -->
        <div class="messages-container" @ref="messagesContainer">
            @foreach (var message in messages)
            {
                <div class="message @(message.SenderId == AuthService.CurrentUser.Id ? "message-own" : "message-other")">
                    <div class="message-header">
                        <strong>@message.SenderUsername</strong>
                        <small class="text-muted">@message.Timestamp.ToLocalTime().ToString("HH:mm")</small>
                    </div>
                    <div class="message-content">@message.Content</div>
                </div>
            }

            @if (typingUsers.Count > 0)
            {
                <div class="typing-indicator">
                    <small class="text-muted">
                        @string.Join(", ", typingUsers) đang typing...
                    </small>
                </div>
            }
        </div>

        <!-- Input Area -->
        <div class="message-input-container">
            <input type="text"
                   class="form-control"
                   placeholder="Nhập tin nhắn..."
                   @bind="messageText"
                   @onkeydown="HandleKeyDown"
                   @oninput="HandleTyping" />
            <button class="btn btn-primary" @onclick="SendMessage" disabled="@(!isConnected || string.IsNullOrWhiteSpace(messageText))">
                Gửi
            </button>
        </div>
    </div>
</div>

<style>
    .chat-room-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--bg-secondary);
    }

    .room-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-lg) var(--spacing-2xl);
        background: white;
        border-bottom: 2px solid var(--color-gray-200);
        box-shadow: var(--shadow-md);
        z-index: 10;
    }

        .room-header .btn-link {
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-semibold);
            color: var(--color-primary);
            display: flex;
            align-items: center;
            gap: var(--spacing-xs);
        }

    .room-info h4 {
        margin: 0;
        font-size: var(--font-size-2xl);
        color: var(--color-gray-900);
    }

    .room-info small {
        display: block;
        margin-top: var(--spacing-xs);
        color: var(--color-gray-500);
    }

    .connection-status .badge {
        padding: 0.5rem 1rem;
        font-size: var(--font-size-sm);
        box-shadow: var(--shadow-sm);
    }

    .room-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .messages-container {
        flex: 1;
        overflow-y: auto;
        padding: var(--spacing-2xl);
        background: linear-gradient(to bottom, #f9fafb 0%, #ffffff 100%);
    }

        .messages-container::-webkit-scrollbar {
            width: 8px;
        }

        .messages-container::-webkit-scrollbar-track {
            background: var(--color-gray-100);
            border-radius: var(--radius-full);
        }

        .messages-container::-webkit-scrollbar-thumb {
            background: var(--color-gray-400);
            border-radius: var(--radius-full);
        }

            .messages-container::-webkit-scrollbar-thumb:hover {
                background: var(--color-gray-500);
            }

    .message {
        margin-bottom: var(--spacing-lg);
        max-width: 65%;
        animation: slideUp 0.3s ease-out;
    }

    .message-own {
        margin-left: auto;
    }

    .message-other {
        margin-right: auto;
    }

    .message-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: var(--spacing-xs);
        padding: 0 var(--spacing-sm);
    }

        .message-header strong {
            font-weight: var(--font-weight-semibold);
            color: var(--color-gray-700);
            font-size: var(--font-size-sm);
        }

        .message-header small {
            color: var(--color-gray-400);
            font-size: var(--font-size-xs);
        }

    .message-content {
        padding: var(--spacing-md) var(--spacing-lg);
        border-radius: var(--radius-xl);
        word-wrap: break-word;
        line-height: var(--line-height-relaxed);
        box-shadow: var(--shadow-sm);
        position: relative;
    }

    .message-own .message-content {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
        color: white;
        border-bottom-right-radius: var(--radius-sm);
    }

    .message-other .message-content {
        background: white;
        color: var(--color-gray-900);
        border-bottom-left-radius: var(--radius-sm);
        border: 1px solid var(--color-gray-200);
    }

    .typing-indicator {
        padding: var(--spacing-md);
        font-style: italic;
        color: var(--color-gray-500);
        font-size: var(--font-size-sm);
        animation: fadeIn 0.3s ease-out;
    }

    .message-input-container {
        display: flex;
        gap: var(--spacing-md);
        padding: var(--spacing-lg) var(--spacing-2xl);
        background: white;
        border-top: 2px solid var(--color-gray-200);
        box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.05);
    }

        .message-input-container input {
            flex: 1;
            font-size: var(--font-size-lg);
            padding: var(--spacing-md) var(--spacing-lg);
            border-radius: var(--radius-full);
            border: 2px solid var(--color-gray-300);
            transition: all var(--transition-fast);
        }

            .message-input-container input:focus {
                border-color: var(--color-primary);
                box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
            }

        .message-input-container .btn {
            padding: var(--spacing-md) var(--spacing-2xl);
            font-size: var(--font-size-lg);
            font-weight: var(--font-weight-semibold);
            border-radius: var(--radius-full);
            box-shadow: var(--shadow-md);
        }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@media (max-width: 768px) {
        .room-header {
            padding: var(--spacing-md);
            flex-wrap: wrap;
        }

        .room-info h4 {
            font-size: var(--font-size-xl);
        }

        .messages-container {
            padding: var(--spacing-md);
        }

        .message {
            max-width: 85%;
        }

        .message-input-container {
            padding: var(--spacing-md);
        }
    }
</style>

@code {
    [Parameter]
    public string RoomId { get; set; } = "";

    private RoomDto? room;
    private List<MessageDto> messages = new();
    private HashSet<string> typingUsers = new();
    private string messageText = "";
    private string roomName = "Chat Room";
    private bool isConnected = false;
    private bool isInitializing = true; // ✅ Flag để track initialization
    private ElementReference messagesContainer;
    private System.Timers.Timer? typingTimer;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"🔵 [Room] OnInitializedAsync START - RoomId: {RoomId}");

        try
        {
            // ✅ Initialize auth
            await AuthService.InitializeAsync();

            Console.WriteLine($"🔵 [Room] Auth initialized");
            Console.WriteLine($"🔵 [Room] IsAuthenticated: {AuthService.IsAuthenticated}");
            Console.WriteLine($"🔵 [Room] CurrentUser: {AuthService.CurrentUser?.Username ?? "NULL"}");

            // ✅ Đợi state ổn định
            await Task.Delay(100);

            if (!AuthService.IsAuthenticated)
            {
                Console.WriteLine("🔴 [Room] Not authenticated, redirecting to /login");
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            Console.WriteLine($"🟢 [Room] Loading room data for RoomId: {RoomId}");

            // ✅ Load room info
            room = await ApiService.GetRoomAsync(RoomId);

            if (room == null)
            {
                Console.WriteLine($"🔴 [Room] Room not found: {RoomId}");
                Navigation.NavigateTo("/rooms");
                return;
            }

            Console.WriteLine($"🟢 [Room] Room loaded: {room.Name}");
            roomName = room.Name;

            // ✅ Load message history
            var messagePage = await ApiService.GetRoomMessagesAsync(RoomId);
            if (messagePage != null)
            {
                messages = messagePage.Messages;
                Console.WriteLine($"🟢 [Room] Loaded {messages.Count} messages");
            }

            // ✅ Connect WebSocket
            await ConnectWebSocket();

            // ✅ Subscribe to WebSocket events
            WebSocketService.OnMessageReceived += HandleMessageReceived;
            WebSocketService.OnUserJoinedRoom += HandleUserJoinedRoom;
            WebSocketService.OnUserLeftRoom += HandleUserLeftRoom;
            WebSocketService.OnUserTyping += HandleUserTyping;
            WebSocketService.OnUserStoppedTyping += HandleUserStoppedTyping;
            WebSocketService.OnConnected += HandleConnected;
            WebSocketService.OnDisconnected += HandleDisconnected;

            // ✅ Join room via WebSocket
            if (isConnected)
            {
                await WebSocketService.JoinRoomAsync(RoomId);
                Console.WriteLine($"🟢 [Room] Joined room via WebSocket");
            }

            Console.WriteLine("🟢 [Room] Initialization completed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Room] Error in OnInitializedAsync: {ex.Message}");
            Console.WriteLine($"🔴 [Room] Stack trace: {ex.StackTrace}");
        }
        finally
        {
            // ✅ Kết thúc initialization
            isInitializing = false;
            StateHasChanged();
            Console.WriteLine("🔵 [Room] OnInitializedAsync END");
        }
    }

    private async Task ConnectWebSocket()
    {
        try
        {
            Console.WriteLine("🔵 [Room] Connecting WebSocket...");
            var token = await AuthService.GetTokenAsync();

            if (!string.IsNullOrEmpty(token))
            {
                await WebSocketService.ConnectAsync(token);
                isConnected = WebSocketService.IsConnected;
                Console.WriteLine($"🟢 [Room] WebSocket connected: {isConnected}");
            }
            else
            {
                Console.WriteLine("🔴 [Room] No token available for WebSocket");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Room] WebSocket connection error: {ex.Message}");
        }
    }

    private void HandleConnected()
    {
        Console.WriteLine("🟢 [Room] WebSocket connected event");
        isConnected = true;
        InvokeAsync(async () =>
        {
            await WebSocketService.JoinRoomAsync(RoomId);
            StateHasChanged();
        });
    }

    private void HandleDisconnected(string reason)
    {
        Console.WriteLine($"🔴 [Room] WebSocket disconnected: {reason}");
        isConnected = false;
        InvokeAsync(StateHasChanged);
    }

    private void HandleMessageReceived(MessageDto message)
    {
        if (message.RoomId == RoomId)
        {
            Console.WriteLine($"🟢 [Room] Message received from {message.SenderUsername}");
            InvokeAsync(() =>
            {
                messages.Add(message);
                StateHasChanged();
                ScrollToBottom();
            });
        }
    }

    private void HandleUserJoinedRoom(string roomId, string username)
    {
        if (roomId == RoomId)
        {
            Console.WriteLine($"🟢 [Room] User joined: {username}");
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleUserLeftRoom(string roomId, string username)
    {
        if (roomId == RoomId)
        {
            Console.WriteLine($"🟡 [Room] User left: {username}");
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleUserTyping(TypingPayload payload)
    {
        if (payload.RoomId == RoomId && payload.UserId != AuthService.CurrentUser?.Id)
        {
            InvokeAsync(() =>
            {
                typingUsers.Add(payload.Username);
                StateHasChanged();
            });
        }
    }

    private void HandleUserStoppedTyping(TypingPayload payload)
    {
        if (payload.RoomId == RoomId)
        {
            InvokeAsync(() =>
            {
                typingUsers.Remove(payload.Username);
                StateHasChanged();
            });
        }
    }

    private async Task SendMessage()
    {
        if (!isConnected || string.IsNullOrWhiteSpace(messageText))
        {
            return;
        }

        Console.WriteLine($"🔵 [Room] Sending message: {messageText}");
        await WebSocketService.SendChatMessageAsync(RoomId, messageText.Trim());
        messageText = "";
        await WebSocketService.SendTypingAsync(RoomId, false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task HandleTyping()
    {
        if (!isConnected)
        {
            return;
        }

        // Send typing indicator
        await WebSocketService.SendTypingAsync(RoomId, true);

        // Reset timer
        typingTimer?.Stop();
        typingTimer = new System.Timers.Timer(2000);
        typingTimer.Elapsed += async (sender, e) =>
        {
            await WebSocketService.SendTypingAsync(RoomId, false);
            typingTimer?.Dispose();
        };
        typingTimer.Start();
    }

    private void ScrollToBottom()
    {
        // Scroll to bottom (requires JS interop in production)
    }

    private void BackToRooms()
    {
        Console.WriteLine("🔵 [Room] Navigating back to /rooms");
        Navigation.NavigateTo("/rooms");
    }

    public async ValueTask DisposeAsync()
    {
        Console.WriteLine($"🔵 [Room] Disposing - RoomId: {RoomId}");

        try
        {
            // Unsubscribe events
            WebSocketService.OnMessageReceived -= HandleMessageReceived;
            WebSocketService.OnUserJoinedRoom -= HandleUserJoinedRoom;
            WebSocketService.OnUserLeftRoom -= HandleUserLeftRoom;
            WebSocketService.OnUserTyping -= HandleUserTyping;
            WebSocketService.OnUserStoppedTyping -= HandleUserStoppedTyping;
            WebSocketService.OnConnected -= HandleConnected;
            WebSocketService.OnDisconnected -= HandleDisconnected;

            // Leave room
            if (isConnected)
            {
                await WebSocketService.LeaveRoomAsync(RoomId);
                Console.WriteLine($"🟢 [Room] Left room via WebSocket");
            }

            typingTimer?.Dispose();

            Console.WriteLine("🟢 [Room] Disposed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Room] Error during disposal: {ex.Message}");
        }
    }
}