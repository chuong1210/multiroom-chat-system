    // File Upload Handlers
    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || string.IsNullOrEmpty(roomId)) return;

        // Validate image
        if (!file.ContentType.StartsWith("image/"))
        {
            Console.WriteLine("🔴 [Chat] Invalid image type");
            return;
        }

        if (file.Size > 10 * 1024 * 1024) // 10MB
        {
            Console.WriteLine("🔴 [Chat] Image too large");
            return;
        }

        isUploadingFile = true;
        uploadingFileName = file.Name;
        uploadProgress = 0;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

            // Simulate progress
            _ = SimulateProgress();

            var message = await ApiService.UploadImageMessageAsync(roomId, stream, file.Name);

            if (message != null)
            {
                uploadProgress = 100;
                Console.WriteLine("🟢 [Chat] Image uploaded successfully");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Chat] Image upload error: {ex.Message}");
        }
        finally
        {
            await Task.Delay(500);
            isUploadingFile = false;
            uploadProgress = 0;
            StateHasChanged();
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || string.IsNullOrEmpty(roomId)) return;

        if (file.Size > 50 * 1024 * 1024) // 50MB
        {
            Console.WriteLine("🔴 [Chat] File too large");
            return;
        }

        isUploadingFile = true;
        uploadingFileName = file.Name;
        uploadProgress = 0;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);

            _ = SimulateProgress();

            var message = await ApiService.UploadFileMessageAsync(roomId, stream, file.Name, file.ContentType);

            if (message != null)
            {
                uploadProgress = 100;
                Console.WriteLine("🟢 [Chat] File uploaded successfully");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Chat] File upload error: {ex.Message}");
        }
        finally
        {
            await Task.Delay(500);
            isUploadingFile = false;
            uploadProgress = 0;
            StateHasChanged();
        }
    }

    private async Task SimulateProgress()
    {
        while (uploadProgress < 90 && isUploadingFile)
        {
            uploadProgress += 10;
            StateHasChanged();
            await Task.Delay(200);
        }
    }

