    private async Task LoadMessages(bool resetPage = false)
    {
        if (resetPage)
        {
            currentPage = 1;
            messages.Clear();
            hasMoreMessages = true;
        }

        if (!hasMoreMessages) return;

        try
        {
            var newMessages = await ApiService.GetPrivateMessagesAsync(UserId, currentPage, PageSize);

            if (newMessages.Count < PageSize)
            {
                hasMoreMessages = false;
            }

            if (resetPage)
            {
                messages = newMessages;
            }
            else
            {
                // Prepend older messages
                messages.InsertRange(0, newMessages);
            }

            currentPage++;
            Console.WriteLine($"🟢 [Chat] Loaded {newMessages.Count} messages (Page {currentPage - 1})");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Chat] Error loading messages: {ex.Message}");
