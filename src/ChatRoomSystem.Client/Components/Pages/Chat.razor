            [el.scrollTop, el.scrollHeight]
        ");

            var scrollTop = scrollInfo[0];
            var oldScrollHeight = scrollInfo[1];

            // Nếu kéo lên gần đỉnh (scrollTop < 50px)
            if (scrollTop < 50 && !isLoadingMore && hasMoreMessages)
            {
                isLoadingMore = true;
                // Không gọi StateHasChanged ở đây để tránh giật

                // 2. Load dữ liệu mới (chèn vào đầu danh sách)
                await LoadMessages();

                isLoadingMore = false;
