        {
            Console.WriteLine($"🔵 [Chat] Loading chat with user: {UserId}");

            var friend = await ApiService.GetUserAsync(UserId);
            if (friend == null)
            {
                Console.WriteLine($"🔴 [Chat] User {UserId} not found");
                Navigation.NavigateTo("/messages");
                return;
            }

            friendName = friend.Username;
            isOnline = friend.IsOnline;
            lastSeen = friend.LastSeen;

            Console.WriteLine($"🟢 [Chat] Friend: {friendName}, Online: {isOnline}");

            roomId = await ApiService.GetOrCreatePrivateRoomAsync(UserId);
            if (string.IsNullOrEmpty(roomId))
            {
                Console.WriteLine($"🔴 [Chat] Failed to create private room");
                return;
            }

            Console.WriteLine($"🟢 [Chat] Room ID: {roomId}");

            // Load initial messages
            await LoadMessages(resetPage: true);
            _shouldScrollToBottom = true;


            // Ensure WebSocket is connected
            if (!WebSocketService.IsConnected)
            {
                Console.WriteLine("🟡 [Chat] WebSocket not connected, reconnecting...");
                var token = await AuthService.GetTokenAsync();
                if (!string.IsNullOrEmpty(token))
                {
                    await WebSocketService.ConnectAsync(token);
                    Console.WriteLine($"🟢 [Chat] WebSocket reconnected: {WebSocketService.IsConnected}");
                }
            }

            // Join room via WebSocket
            if (WebSocketService.IsConnected)
            {
                await WebSocketService.JoinRoomAsync(roomId);
                Console.WriteLine($"🟢 [Chat] Joined room via WebSocket");
            }
            else
            {
                Console.WriteLine($"🔴 [Chat] Failed to connect WebSocket!");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Chat] Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
