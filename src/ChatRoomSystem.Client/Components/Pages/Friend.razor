    @@media (max-width: 768px) {
        .friends-grid {
            grid-template-columns: 1fr;
        }

        .friend-card {
            flex-direction: column;
            text-align: center;
        }

        .friend-actions {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@code {
    private List<UserDto> friends = new();
    private List<FriendRequestDto> friendRequests = new();
    private List<UserDto> searchResults = new();
    private string activeTab = "friends";
    private bool isLoading = false;
    private bool showSearchModal = false;
    private bool isSearching = false;
    private string searchQuery = "";
    private HashSet<string> addedFriendIds = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            if (activeTab == "friends")
            {
                friends = await ApiService.GetFriendsAsync();
            }
            else
            {
                friendRequests = await ApiService.GetFriendRequestsAsync();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        await LoadData();
    }

    private void ShowSearchModal()
    {
        showSearchModal = true;
        searchQuery = "";
        searchResults.Clear();
    }

    private void HideSearchModal()
    {
        showSearchModal = false;
    }

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Length < 2)
        {
            searchResults.Clear();
            return;
        }

        isSearching = true;
        try
        {
            await Task.Delay(300); // Debounce
            searchResults = await ApiService.SearchUsersAsync(searchQuery);
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task SendFriendRequest(string userId)
    {
        var success = await ApiService.SendFriendRequestAsync(userId);
        if (success)
        {
            addedFriendIds.Add(userId);
            StateHasChanged();
        }
    }

    private bool IsFriendOrRequested(string userId)
    {
        return friends.Any(f => f.Id == userId) || addedFriendIds.Contains(userId);
    }

    private async Task AcceptRequest(string requestId)
    {
        var success = await ApiService.RespondFriendRequestAsync(requestId, true);
        if (success)
        {
            await LoadData();
        }
    }

    private async Task RejectRequest(string requestId)
    {
        var success = await ApiService.RespondFriendRequestAsync(requestId, false);
        if (success)
        {
            await LoadData();
        }
    }

    private async Task RemoveFriend(string friendId)
    {
        // TODO: Implement remove friend
        // await ApiService.RemoveFriendAsync(friendId);
        await LoadData();
    }

    private void StartChat(string friendId)
    {
        Navigation.NavigateTo($"/chat/{friendId}");
    }

    private string GetInitials(string? username)
    {
        if (string.IsNullOrEmpty(username))
            return "?";

        var parts = username.Split(' ');
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return username.Length >= 2
            ? username.Substring(0, 2).ToUpper()
            : username[0].ToString().ToUpper();
    }

    private string GetRelativeTime(DateTime dateTime)
    {
        var timeSpan = DateTime.UtcNow - dateTime.ToUniversalTime();

        if (timeSpan.TotalMinutes < 1)
            return "just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";

        return dateTime.ToString("MMM dd");
    }
}