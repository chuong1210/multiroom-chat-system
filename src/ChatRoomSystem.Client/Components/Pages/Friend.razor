@page "/friends"
@using ChatRoomSystem.Shared.Models
@using ChatRoomSystem.Client.Services
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Friends - Chat Room System</PageTitle>

<div class="friends-container">
    <!-- Header -->
    <div class="page-header">
        <h2>👥 Friends</h2>
        <button class="btn btn-primary" @onclick="ShowSearchModal">
            <span>➕ Add Friend</span>
        </button>
    </div>

    <!-- Tabs -->
    <div class="tabs">
        <button class="tab @(activeTab == "friends" ? "active" : "")" @onclick='() => SwitchTab("friends")'>
            My Friends (@friends.Count)
        </button>
        <button class="tab @(activeTab == "requests" ? "active" : "")" @onclick='() => SwitchTab("requests")'>
            Friend Requests (@friendRequests.Count)
        </button>
    </div>

    <!-- Content -->
    <div class="content">
        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner-border"></div>
                <p>Loading...</p>
            </div>
        }
        else if (activeTab == "friends")
        {
            <!-- Friends List -->
            @if (friends.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">😢</div>
                    <h3>No friends yet</h3>
                    <p>Start by searching and adding friends!</p>
                    <button class="btn btn-primary" @onclick="ShowSearchModal">Add Friend</button>
                </div>
            }
            else
            {
                <div class="friends-grid">
                    @foreach (var friend in friends)
                    {
                        <div class="friend-card">
                            <div class="friend-avatar">
                                @GetInitials(friend.Username)
                                <span class="status-dot @(friend.IsOnline ? "online" : "offline")"></span>
                            </div>
                            <div class="friend-info">
                                <h4>@friend.Username</h4>
                                <p class="status">
                                    @if (friend.IsOnline)
                                    {
                                        <span class="online">● Online</span>
                                    }
                                    else
                                    {
                                        <span class="offline">○ Last seen @GetRelativeTime(friend.LastSeen)</span>
                                    }
                                </p>
                            </div>
                            <div class="friend-actions">
                                <button class="btn btn-sm btn-primary" @onclick="() => StartChat(friend.Id)">
                                    💬 Chat
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => RemoveFriend(friend.Id)">
                                    🗑️
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <!-- Friend Requests -->
            @if (friendRequests.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <h3>No pending requests</h3>
                    <p>You don't have any friend requests at the moment.</p>
                </div>
            }
            else
            {
                <div class="requests-list">
                    @foreach (var request in friendRequests)
                    {
                        <div class="request-card">
                            <div class="request-avatar">
                                @GetInitials(request.FromUsername)
                            </div>
                            <div class="request-info">
                                <h4>@request.FromUsername</h4>
                                <p class="request-time">@GetRelativeTime(request.CreatedAt)</p>
                            </div>
                            <div class="request-actions">
                                <button class="btn btn-sm btn-success" @onclick="() => AcceptRequest(request.Id)">
                                    ✓ Accept
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => RejectRequest(request.Id)">
                                    ✕ Reject
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Search Modal -->
@if (showSearchModal)
{
    <div class="modal-overlay" @onclick="HideSearchModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>🔍 Search Users</h3>
                <button class="btn-close" @onclick="HideSearchModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="search-box">
                    <input type="text"
                           class="form-control"
                           placeholder="Search by username or email..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           @onkeyup="HandleSearch" />
                </div>

                @if (isSearching)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm"></div>
                    </div>
                }
                else if (searchResults.Count > 0)
                {
                    <div class="search-results">
                        @foreach (var user in searchResults)
                        {
                            <div class="search-result-item">
                                <div class="user-avatar">@GetInitials(user.Username)</div>
                                <div class="user-info">
                                    <strong>@user.Username</strong>
                                    <small>@user.Email</small>
                                </div>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => SendFriendRequest(user.Id)"
                                        disabled="@IsFriendOrRequested(user.Id)">
                                    @if (IsFriendOrRequested(user.Id))
                                    {
                                        <span>✓ Added</span>
                                    }
                                    else
                                    {
                                        <span>+ Add</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <div class="text-center text-muted py-3">
                        <p>No users found</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
