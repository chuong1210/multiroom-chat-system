@page "/meeting/{RoomId}"
@using ChatRoomSystem.Shared.Models
@using ChatRoomSystem.Client.Services
@using ChatRoomSystem.Client.Components.Shared
@inject AuthService AuthService
@inject ApiService ApiService
@inject NavigationManager Navigation
@* @rendermode InteractiveServer *@

<PageTitle>Meeting - @roomName</PageTitle>

@if (AuthService.CurrentUser == null || room == null)
{
    <div class="text-center py-5">
        <div class="spinner-border"></div>
        <p>Loading...</p>
    </div>
    return;
}

<div class="meeting-room-container">
    <!-- Header -->
    <div class="meeting-header">
        <button class="btn btn-link" @onclick="BackToRooms">← Back</button>
        <div class="room-info">
            <h4>🎯 @room.Name - Meeting Room</h4>
            <small class="text-muted">Collaborative workspace with video, chat, and whiteboard</small>
        </div>
        <div class="mode-switcher">
            <button class="btn @(currentMode == "video" ? "btn-primary" : "btn-outline-primary") btn-sm"
                    @onclick='() => SwitchMode("video")'>
                📹 Video
            </button>
            <button class="btn @(currentMode == "whiteboard" ? "btn-primary" : "btn-outline-primary") btn-sm"
                    @onclick='() => SwitchMode("whiteboard")'>
                🎨 Whiteboard
            </button>
            <button class="btn @(currentMode == "chat" ? "btn-primary" : "btn-outline-primary") btn-sm"
                    @onclick='() => SwitchMode("chat")'>
                💬 Chat
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="meeting-content">
        @if (currentMode == "video")
        {
            <div class="video-mode">
                <VideoCall RoomId="@RoomId" RemoteName="@room.Name" />
                <div class="meeting-info mt-3">
                    <h5>Video Call Features:</h5>
                    <ul>
                        <li>✅ Real-time peer-to-peer video/audio</li>
                        <li>✅ Toggle camera and microphone</li>
                        <li>✅ Screen sharing support</li>
                        <li>✅ Minimize video window</li>
                        <li>⚠️ Note: Currently supports 1-1 calls. Group call coming soon!</li>
                    </ul>
                </div>
            </div>
        }
        else if (currentMode == "whiteboard")
        {
            <div class="whiteboard-mode">
                <Whiteboard RoomId="@RoomId" />
                <div class="meeting-info mt-3">
                    <h5>Whiteboard Features:</h5>
                    <ul>
                        <li>✅ Real-time collaborative drawing</li>
                        <li>✅ Multiple tools: Pen, Eraser, Line, Rectangle, Circle</li>
                        <li>✅ Color picker and stroke width adjustment</li>
                        <li>✅ Clear canvas</li>
                        <li>✅ Save/Export as PNG image</li>
                        <li>✅ Touch support for tablets/phones</li>
                    </ul>
                </div>
            </div>
        }
        else if (currentMode == "chat")
        {
            <div class="chat-mode">
                <div class="alert alert-info">
                    <strong>💬 Chat Mode</strong>
                    <p>Go to <a href="/room/@RoomId">Chat Room Page</a> for full chat experience with:</p>
                    <ul>
                        <li>Real-time messaging</li>
                        <li>Typing indicators</li>
                        <li>Message history</li>
                        <li>User join/leave notifications</li>
                    </ul>
                    <a href="/room/@RoomId" class="btn btn-primary">Go to Chat Room</a>
                </div>
            </div>
        }
    </div>

    <!-- Instructions Panel -->
    <div class="instructions-panel">
        <h5>🚀 Quick Start Guide</h5>

        <div class="accordion" id="instructionsAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#videoInstructions">
                        📹 Video Call Setup
                    </button>
                </h2>
                <div id="videoInstructions" class="accordion-collapse collapse show" data-bs-parent="#instructionsAccordion">
                    <div class="accordion-body">
                        <ol>
                            <li>Click "Start Video Call" button</li>
                            <li>Allow camera/microphone permissions when prompted</li>
                            <li>Wait for other participant to join</li>
                            <li>Use controls: Toggle video/audio, Share screen</li>
                        </ol>
                        <p><strong>Note:</strong> Requires modern browser with WebRTC support (Chrome, Firefox, Edge, Safari 11+)</p>
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#whiteboardInstructions">
                        🎨 Whiteboard Usage
                    </button>
                </h2>
                <div id="whiteboardInstructions" class="accordion-collapse collapse" data-bs-parent="#instructionsAccordion">
                    <div class="accordion-body">
                        <ol>
                            <li>Select tool from toolbar (Pen, Eraser, Line, Rect, Circle)</li>
                            <li>Choose color from color picker</li>
                            <li>Adjust stroke width with slider</li>
                            <li>Draw on canvas - changes sync in real-time!</li>
                            <li>Click "Clear" to erase entire canvas</li>
                            <li>Click "Save" to download as image</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .meeting-room-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: var(--spacing-xl);
        min-height: 100vh;
        animation: fadeIn 0.4s ease-out;
    }

    .meeting-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-xl);
        background: white;
        border-radius: var(--radius-2xl);
        box-shadow: var(--shadow-xl);
        margin-bottom: var(--spacing-2xl);
        border: 2px solid var(--color-gray-100);
    }

    .meeting-header h4 {
        margin: 0;
        font-size: var(--font-size-2xl);
        font-weight: var(--font-weight-bold);
    }

    .meeting-header small {
        display: block;
        margin-top: var(--spacing-xs);
        color: var(--color-gray-500);
    }

    .mode-switcher {
        display: flex;
        gap: var(--spacing-sm);
        padding: var(--spacing-xs);
        background: var(--color-gray-100);
        border-radius: var(--radius-xl);
    }

    .mode-switcher .btn {
        padding: var(--spacing-sm) var(--spacing-lg);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        border-radius: var(--radius-lg);
        transition: all var(--transition-base);
    }

    .mode-switcher .btn-primary {
        box-shadow: var(--shadow-md);
    }

    .mode-switcher .btn-outline-primary {
        background: white;
    }

    .meeting-content {
        background: white;
        border-radius: var(--radius-2xl);
        padding: var(--spacing-2xl);
        box-shadow: var(--shadow-lg);
        margin-bottom: var(--spacing-2xl);
        min-height: 600px;
        border: 2px solid var(--color-gray-100);
    }

    .meeting-info {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(167, 139, 250, 0.05) 100%);
        padding: var(--spacing-lg);
        border-radius: var(--radius-xl);
        border-left: 4px solid var(--color-primary);
        box-shadow: var(--shadow-sm);
        margin-top: var(--spacing-xl);
    }

    .meeting-info h5 {
        color: var(--color-primary);
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--spacing-md);
    }

    .meeting-info ul {
        margin-bottom: 0;
        padding-left: var(--spacing-lg);
    }

    .meeting-info ul li {
        margin-bottom: var(--spacing-sm);
        color: var(--color-gray-700);
    }

    .instructions-panel {
        background: white;
        border-radius: var(--radius-2xl);
        padding: var(--spacing-2xl);
        box-shadow: var(--shadow-lg);
        border: 2px solid var(--color-gray-100);
    }

    .instructions-panel h5 {
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        margin-bottom: var(--spacing-lg);
        color: var(--color-gray-900);
    }

    .accordion-item {
        border: 1px solid var(--color-gray-200);
        border-radius: var(--radius-lg);
        margin-bottom: var(--spacing-md);
        overflow: hidden;
    }

    .accordion-button {
        padding: var(--spacing-lg);
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-semibold);
        background: white;
        transition: all var(--transition-base);
    }

    .accordion-button:hover {
        background: var(--color-gray-50);
    }

    .accordion-button:not(.collapsed) {
        background: var(--color-primary);
        color: white;
    }

    .accordion-body {
        padding: var(--spacing-lg);
        background: var(--bg-secondary);
    }

    .accordion-body ol {
        padding-left: var(--spacing-lg);
    }

    .accordion-body li {
        margin-bottom: var(--spacing-sm);
        line-height: var(--line-height-relaxed);
    }

    @@media (max-width: 768px) {
        .meeting-room-container {
            padding: var(--spacing-md);
        }

        .meeting-header {
            flex-direction: column;
            gap: var(--spacing-md);
            align-items: flex-start;
        }

        .mode-switcher {
            width: 100%;
        }

        .mode-switcher .btn {
            flex: 1;
            padding: var(--spacing-sm);
            font-size: var(--font-size-sm);
        }

        .meeting-content {
            padding: var(--spacing-lg);
            min-height: 400px;
        }
    }
</style>

@code {
    [Parameter]
    public string RoomId { get; set; } = "";

    private RoomDto? room;
    private string roomName = "Meeting Room";
    private string currentMode = "video";

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Load room info
        room = await ApiService.GetRoomAsync(RoomId);
        if (room == null)
        {
            Navigation.NavigateTo("/rooms");
            return;
        }

        roomName = room.Name;
    }

    private void SwitchMode(string mode)
    {
        currentMode = mode;
    }

    private void BackToRooms()
    {
        Navigation.NavigateTo("/rooms");
    }
}
