@page "/login"
@using ChatRoomSystem.Shared.Models
@using ChatRoomSystem.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Đăng nhập - Chat Room System</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h2 class="text-center mb-4">
            @if (isLoginMode)
            {
                <span>Đăng nhập</span>
            }
            else
            {
                <span>Đăng ký</span>
            }
        </h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@HandleSubmit">
            <DataAnnotationsValidator />

            @if (!isLoginMode)
            {
                <div class="form-group-animated">
                    <label class="form-label">👤 Username</label>
                    <InputText @bind-Value="registerModel.Username" class="form-control" placeholder="Nhập username của bạn" />
                </div>
            }

            <div class="form-group-animated">
                <label class="form-label">📧 Email</label>
                <InputText @bind-Value="loginModel.Email" class="form-control" type="email" placeholder="example@email.com" />
            </div>

            <div class="form-group-animated">
                <label class="form-label">🔒 Password</label>
                <InputText @bind-Value="loginModel.Password" class="form-control" type="password" placeholder="Nhập mật khẩu" />
            </div>

            <div class="submit-btn-wrapper">
                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    @(isLoginMode ? "🚀 Đăng nhập" : "✨ Đăng ký ngay")
                </button>
            </div>
        </EditForm>

        <div class="toggle-mode-btn">
            <button class="btn btn-link" @onclick="ToggleMode">
                @if (isLoginMode)
                {
                    <span>Chưa có tài khoản? <strong>Đăng ký ngay</strong></span>
                }
                else
                {
                    <span>Đã có tài khoản? <strong>Đăng nhập</strong></span>
                }
            </button>
        </div>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: var(--bg-gradient);
        padding: var(--spacing-lg);
        position: relative;
        overflow: hidden;
    }

    .login-container::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: pulse 15s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-10%, -10%) scale(1.1); }
    }

    .login-card {
        background: white;
        padding: var(--spacing-2xl);
        border-radius: var(--radius-2xl);
        box-shadow: var(--shadow-2xl);
        width: 100%;
        max-width: 420px;
        position: relative;
        z-index: 1;
        animation: slideUp 0.5s ease-out;
    }

    .login-card h2 {
        font-size: var(--font-size-3xl);
        font-weight: var(--font-weight-bold);
        color: var(--color-gray-900);
        margin-bottom: var(--spacing-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-sm);
    }

    .login-card h2::before {
        content: '💬';
        font-size: 2rem;
    }

    .form-group-animated {
        position: relative;
        margin-bottom: var(--spacing-lg);
    }

    .form-group-animated .form-label {
        font-weight: var(--font-weight-semibold);
        color: var(--color-gray-700);
        margin-bottom: var(--spacing-sm);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
    }

    .form-group-animated .form-control {
        transition: all var(--transition-base);
    }

    .form-group-animated .form-control:focus {
        transform: translateY(-2px);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1), var(--shadow-md);
    }

    .submit-btn-wrapper {
        margin-top: var(--spacing-xl);
    }

    .submit-btn-wrapper .btn {
        width: 100%;
        padding: 0.875rem 1.5rem;
        font-size: var(--font-size-lg);
        font-weight: var(--font-weight-semibold);
        box-shadow: var(--shadow-md);
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: var(--spacing-xl) 0;
        color: var(--color-gray-400);
        font-size: var(--font-size-sm);
    }

    .divider::before,
    .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid var(--color-gray-300);
    }

    .divider span {
        padding: 0 var(--spacing-md);
    }

    .toggle-mode-btn {
        text-align: center;
        margin-top: var(--spacing-lg);
    }

    .toggle-mode-btn .btn-link {
        font-size: var(--font-size-base);
        font-weight: var(--font-weight-medium);
        padding: var(--spacing-sm) var(--spacing-md);
        border-radius: var(--radius-lg);
        transition: all var(--transition-base);
    }

    .toggle-mode-btn .btn-link:hover {
        background: var(--color-gray-100);
        transform: none;
    }

    .alert {
        animation: slideDown 0.3s ease-out;
    }

    @media (max-width: 480px) {
        .login-card {
            padding: var(--spacing-xl);
        }

        .login-card h2 {
            font-size: var(--font-size-2xl);
        }
    }
</style>

@code {
    private LoginDto loginModel = new();
    private RegisterDto registerModel = new();
    private bool isLoginMode = true;
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        // Check if already logged in
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/rooms");
        }
    }

    private void ToggleMode()
    {
        isLoginMode = !isLoginMode;
        errorMessage = null;
        successMessage = null;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            if (isLoginMode)
            {
                var (success, message) = await AuthService.LoginAsync(loginModel);
                if (success)
                {
                    successMessage = message;
                    await Task.Delay(500);
                    Navigation.NavigateTo("/rooms");
                }
                else
                {
                    errorMessage = message;
                }
            }
            else
            {
                registerModel.Email = loginModel.Email;
                registerModel.Password = loginModel.Password;

                var (success, message) = await AuthService.RegisterAsync(registerModel);
                if (success)
                {
                    successMessage = message;
                    await Task.Delay(500);
                    Navigation.NavigateTo("/rooms");
                }
                else
                {
                    errorMessage = message;
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}
