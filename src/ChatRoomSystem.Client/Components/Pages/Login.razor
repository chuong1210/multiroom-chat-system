@page "/login"
@using ChatRoomSystem.Shared.Models
@using ChatRoomSystem.Client.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>@(isLoginMode ? "Đăng nhập" : "Đăng ký") - Chat Room System</PageTitle>

<div class="auth-wrapper">
    <!-- Background shapes for atmosphere -->
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>

    <div class="auth-container">
        <!-- Left Side: Visual/Welcome -->
        <div class="auth-visual">
            <div class="visual-content">
                <div class="logo-area">
                    <span class="logo-icon">💬</span>
                    <span class="logo-text">ChatRoom</span>
                </div>
                <div class="welcome-text">
                    <h3>@(isLoginMode ? "Chào mừng trở lại!" : "Tham gia cùng chúng tôi")</h3>
                    <p>
                        @(isLoginMode
                                                ? "Kết nối với bạn bè và đồng nghiệp qua nền tảng nhắn tin nhanh chóng và bảo mật."
                                                : "Tạo tài khoản miễn phí để bắt đầu cuộc trò chuyện không giới hạn.")
                    </p>
                </div>
                <!-- Abstract decorative circles -->
                <div class="visual-circles">
                    <div class="circle c-1"></div>
                    <div class="circle c-2"></div>
                </div>
            </div>
        </div>

        <!-- Right Side: Form -->
        <div class="auth-form-side">
            <div class="form-header">
                <h2>@(isLoginMode ? "Đăng nhập" : "Tạo tài khoản")</h2>
                <p class="sub-text">Vui lòng nhập thông tin của bạn</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="custom-alert error">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="custom-alert success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span>@successMessage</span>
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="@HandleSubmit" class="styled-form">
                <DataAnnotationsValidator />

                @if (!isLoginMode)
                {
                    <div class="input-group-modern slide-in">
                        <label>Tên người dùng</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </span>
                            <InputText @bind-Value="registerModel.Username" placeholder="Chọn tên hiển thị" />
                        </div>
                    </div>
                }

                <div class="input-group-modern">
                    <label>Email</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        </span>
                        <InputText @bind-Value="loginModel.Email" type="email" placeholder="name@example.com" />
                    </div>
                </div>

                <div class="input-group-modern">
                    <label>Mật khẩu</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </span>
                        <InputText @bind-Value="loginModel.Password" type="password" placeholder="••••••••" />
                    </div>
                </div>

                <button type="submit" class="btn-submit" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="loader"></span>
                    }
                    else
                    {
                        @(isLoginMode ? "Đăng nhập" : "Đăng ký tài khoản")
                    }
                </button>
            </EditForm>

            <div class="form-footer">
                <p>
                    @(isLoginMode ? "Chưa có tài khoản?" : "Đã có tài khoản?")
                    <button type="button" class="link-btn" @onclick="ToggleMode">
                        @(isLoginMode ? "Đăng ký ngay" : "Đăng nhập")
                    </button>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    /* Variables for Theme */
    :root {
        --primary-color: #6366f1; /* Indigo 500 */
        --primary-hover: #4f46e5; /* Indigo 600 */
        --bg-gradient-start: #e0e7ff;
        --bg-gradient-end: #f3f4f6;
        --text-dark: #1f2937;
        --text-gray: #6b7280;
        --card-radius: 24px;
        --input-radius: 12px;
        --transition-speed: 0.3s;
    }

    /* Layout Wrapper */
    .auth-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, var(--bg-gradient-start) 0%, #c7d2fe 100%);
        position: relative;
        overflow: hidden;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Floating Background Shapes */
    .bg-shape {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        z-index: 0;
        animation: float 20s infinite;
    }

    .shape-1 {
        width: 400px;
        height: 400px;
        background: rgba(99, 102, 241, 0.4);
        top: -100px;
        left: -100px;
    }

    .shape-2 {
        width: 300px;
        height: 300px;
        background: rgba(167, 139, 250, 0.4);
        bottom: -50px;
        right: -50px;
        animation-delay: -5s;
    }

    /* Main Container Card */
    .auth-container {
        display: flex;
        width: 900px;
        max-width: 95%;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: var(--card-radius);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        z-index: 1;
        min-height: 600px;
    }

    /* Left Side: Visual */
    .auth-visual {
        flex: 1;
        background: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: white;
        position: relative;
        overflow: hidden;
    }

    .visual-content {
        position: relative;
        z-index: 2;
    }

    .logo-area {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 40px;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .welcome-text h3 {
        font-size: 2.5rem;
        line-height: 1.2;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .welcome-text p {
        font-size: 1.1rem;
        opacity: 0.9;
        line-height: 1.6;
    }

    /* Decorative Circles on Visual Side */
    .visual-circles .circle {
        position: absolute;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .c-1 {
        width: 200px;
        height: 200px;
        bottom: -50px;
        right: -50px;
    }

    .c-2 {
        width: 100px;
        height: 100px;
        top: 50px;
        right: 50px;
    }

    /* Right Side: Form */
    .auth-form-side {
        flex: 1;
        padding: 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: white;
    }

    .form-header {
        text-align: center;
        margin-bottom: 30px;
    }

        .form-header h2 {
            color: var(--text-dark);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .form-header .sub-text {
            color: var(--text-gray);
        }

    /* Form Elements */
    .styled-form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .input-group-modern {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .input-group-modern label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-left: 4px;
        }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-gray);
        pointer-events: none;
        transition: var(--transition-speed);
    }

    .input-wrapper input {
        width: 100%;
        padding: 14px 14px 14px 45px;
        border: 2px solid #e5e7eb;
        border-radius: var(--input-radius);
        font-size: 1rem;
        outline: none;
        transition: all var(--transition-speed);
        background: #f9fafb;
    }

        .input-wrapper input:focus {
            border-color: var(--primary-color);
            background: white;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

            .input-wrapper input:focus + .input-icon {
                color: var(--primary-color);
            }

    /* Button */
    .btn-submit {
        margin-top: 10px;
        width: 100%;
        padding: 14px;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: var(--input-radius);
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--transition-speed);
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.3);
    }

        .btn-submit:hover:not(:disabled) {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.4);
        }

        .btn-submit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    /* Footer Links */
    .form-footer {
        margin-top: 25px;
        text-align: center;
        color: var(--text-gray);
        font-size: 0.95rem;
    }

    .link-btn {
        background: none;
        border: none;
        color: var(--primary-color);
        font-weight: 600;
        cursor: pointer;
        padding: 0 5px;
        font-size: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

        .link-btn:hover {
            color: var(--primary-hover);
        }

    /* Alerts */
    .custom-alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        animation: slideDown 0.3s ease-out;
    }

        .custom-alert.error {
            background: #fef2f2;
            color: #ef4444;
            border: 1px solid #fecaca;
        }

        .custom-alert.success {
            background: #ecfdf5;
            color: #10b981;
            border: 1px solid #a7f3d0;
        }

    /* Loading Spinner */
    .loader {
        width: 20px;
        height: 20px;
        border: 2px solid #fff;
        border-bottom-color: transparent;
        border-radius: 50%;
        display: inline-block;
        box-sizing: border-box;
        animation: rotation 1s linear infinite;
    }

    /* Animations */
    @@keyframes rotation {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(-20px, 20px);
        }
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .slide-in {
        animation: slideDown 0.4s ease-out;
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .auth-container {
            flex-direction: column;
            width: 90%;
            min-height: auto;
        }

        .auth-visual {
            padding: 30px;
            text-align: center;
        }

        .logo-area {
            justify-content: center;
        }

        .visual-circles {
            display: none;
        }

        .auth-form-side {
            padding: 30px;
        }
    }
</style>

@code {
    private LoginDto loginModel = new();
    private RegisterDto registerModel = new();
    private bool isLoginMode = true;
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        // Check if already logged in
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/rooms");
        }
    }

    private void ToggleMode()
    {
        isLoginMode = !isLoginMode;
        errorMessage = null;
        successMessage = null;
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            if (isLoginMode)
            {
                Console.WriteLine("🔵 [Login] Starting login...");
                var (success, message) = await AuthService.LoginAsync(loginModel);

                if (success)
                {
                    successMessage = message;
                    Console.WriteLine($"🟢 [Login] Login successful - User: {AuthService.CurrentUser?.Username}");

                    await Task.Delay(200);
                    Navigation.NavigateTo("/rooms");
                }
                else
                {
                    errorMessage = message;
                    Console.WriteLine($"🔴 [Login] Login failed: {message}");
                }
            }
            else
            {
                registerModel.Email = loginModel.Email;
                registerModel.Password = loginModel.Password;

                Console.WriteLine("🔵 [Login] Starting register...");
                var (success, message) = await AuthService.RegisterAsync(registerModel);

                if (success)
                {
                    successMessage = message;
                    Console.WriteLine($"🟢 [Login] Register successful");

                    await Task.Delay(200);
                    Navigation.NavigateTo("/rooms");
                }
                else
                {
                    errorMessage = message;
                    Console.WriteLine($"🔴 [Login] Register failed: {message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🔴 [Login] Exception: {ex.Message}");
            errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}